<mxfile host="CT-CORA3D"><diagram id="d" name="construction_guide"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Entrées&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;&lt;font face='Menlo' style='font-size:11px'&gt;prescription.json&lt;/font&gt;&lt;br&gt;os planifié, os voisins,&lt;br&gt;cartilage&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdf0e2;strokeColor=#b8611a;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="250" height="112" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Grille de 0,3 mm&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;distance signée d à l'os&lt;br&gt;(négative dans l'os)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f5e4;strokeColor=#3a7d2c;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="20" width="250" height="112" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Primitives&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;coque j ≤ d ≤ j + e, tours,&lt;br&gt;manchons (union lisse)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f5e4;strokeColor=#3a7d2c;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="20" width="250" height="112" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Contraintes dures&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;jeu à l'os et aux voisins, pas de&lt;br&gt;contre-dépouille, ni entre les os,&lt;br&gt;ni sur le cartilage&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f5e4;strokeColor=#3a7d2c;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="170" width="250" height="112" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Surface et solide&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;matière trop fine retirée,&lt;br&gt;isosurface F = 0&lt;br&gt;→ solide exact&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f5e4;strokeColor=#3a7d2c;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="170" width="250" height="112" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Booléens exacts&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;fentes, trous, chanfreins,&lt;br&gt;séparation des moitiés,&lt;br&gt;ponts (manifold3d)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f5e4;strokeColor=#3a7d2c;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="250" height="112" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Guide de réduction&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;barre et 4 manchons parallèles&lt;br&gt;sur l'os corrigé (trait&lt;br&gt;de scie compensé)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f5e4;strokeColor=#3a7d2c;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="250" height="112" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Contrôles indépendants&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;jeu mesuré, retrait, appui,&lt;br&gt;étanchéité, voisins…&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fbe9e9;strokeColor=#b03a3a;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="320" width="250" height="112" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Fichiers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;&lt;font face='Menlo' style='font-size:11px'&gt;guide_coupe.stl&lt;/font&gt;, &lt;font face='Menlo' style='font-size:11px'&gt;guide_reduction.stl&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo' style='font-size:11px'&gt;guide.json&lt;/font&gt;, plans 2D&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdf0e2;strokeColor=#b8611a;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="320" width="250" height="112" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Avenir Next;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Avenir Next;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Avenir Next;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Avenir Next;fontSiz