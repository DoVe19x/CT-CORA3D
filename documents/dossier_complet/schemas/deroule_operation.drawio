<mxfile host="CT-CORA3D"><diagram id="d" name="deroule_operation"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;1 · Abord et pose&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;le guide de coupe ne s'emboîte&lt;br&gt;que dans une seule position&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1eaf7;strokeColor=#6f4a99;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="250" height="108" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;2 · Forage des broches&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;2 proximales, puis 2 distales,&lt;br&gt;à travers les manchons&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1eaf7;strokeColor=#6f4a99;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="20" width="250" height="108" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;3 · Coupe&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;par chaque fente, jusqu'à la&lt;br&gt;profondeur de lame indiquée&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1eaf7;strokeColor=#6f4a99;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="20" width="250" height="108" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;4 · Séparer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;couper les 2 ponts ; retirer&lt;br&gt;les moitiés, puis le coin d'os&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1eaf7;strokeColor=#6f4a99;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="170" width="250" height="108" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;5 · Corriger&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;fermer (ou ouvrir) et tourner&lt;br&gt;jusqu'à broches parallèles&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdf0e2;strokeColor=#b8611a;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="170" width="250" height="108" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;6 · Guide de réduction&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;l'enfiler sur les broches&lt;br&gt;jusqu'au contact de l'os&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f5e4;strokeColor=#3a7d2c;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="250" height="108" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;7 · Fixer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;plaque ; puis retirer le guide&lt;br&gt;de réduction et les broches&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1eaf7;strokeColor=#6f4a99;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="250" height="108" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Avenir Next;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Avenir Next;fontSize=12;labelBackgroundColor=#ffffff;exi