<mxfile host="CT-CORA3D"><diagram id="d" name="parcours_requete"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;1 · Clic sur « Segmenter la série »&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;&lt;font face='Menlo' style='font-size:11px'&gt;app.js&lt;/font&gt; envoie /api/action, action « segmenter »&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#1f5f8b;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="600" height="68" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;2 · Le serveur reçoit la demande&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;&lt;font face='Menlo' style='font-size:11px'&gt;serveur.py&lt;/font&gt; met la tâche en file et répond tout de suite&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="112" width="600" height="68" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;3 · Le fil principal exécute&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;&lt;font face='Menlo' style='font-size:11px'&gt;segmenter()&lt;/font&gt; → &lt;font face='Menlo' style='font-size:11px'&gt;lancer_tout.traiter()&lt;/font&gt; → étapes 1 à 6&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f5e4;strokeColor=#3a7d2c;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="204" width="600" height="68" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;4 · L'interface suit l'avancement&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;elle interroge &lt;font face='Menlo' style='font-size:11px'&gt;/api/etat&lt;/font&gt; plusieurs fois par seconde&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#1f5f8b;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="296" width="600" height="68" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;5 · Le résultat s'affiche&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;coupes colorées, os en 3D, carte « Os à planifier »&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#1f5f8b;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="388" width="600" height="68" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Avenir Next;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Avenir Next;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Avenir Next;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Avenir Next;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geome