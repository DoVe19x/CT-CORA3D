<mxfile host="CT-CORA3D"><diagram id="d" name="choix_du_coin"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Pour chaque coin : fermeture et ouverture&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;la scie entre à l'opposé de la charnière&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdf0e2;strokeColor=#b8611a;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=14;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="150" y="10" width="420" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;La scie peut-elle entrer&lt;br&gt;par un abord chirurgical&lt;br&gt;habituel ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=13;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="210" y="100" width="300" height="120" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Oui&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;le coin est possible&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f5e4;strokeColor=#3a7d2c;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=14;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="10" y="250" width="230" height="64" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Non&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;ce coin est écarté (ou le guide est décalé)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fbe9e9;strokeColor=#b03a3a;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=14;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="480" y="250" width="230" height="64" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Avenir Next;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Avenir Next;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Avenir Next;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;Si les deux coins sont possibles, on choisit avec, dans l'ordre :&lt;/b&gt;&lt;br&gt;1. la charnière d'os qui peut rester intacte (plus stable)&lt;br&gt;2. la coupe au CORA (pas de décalage de l'os)&lt;br&gt;3. un coin assez épais pour deux traits de scie&lt;br&gt;4. une ouverture pas trop grande (moins de 40 % de la largeur de l'os)&lt;br&gt;5. la longueur du membre (fermer raccourcit, ouvrir allonge)&lt;br&gt;6. sinon la fermeture : les deux morceaux d'os restent en contact" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdf0e2;strokeColor=#b8611a;strokeWidth=1.5;fontFamily=Avenir Next;fontSize=13;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="10" y="350" width="700" height="156" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Avenir Next;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1643;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>