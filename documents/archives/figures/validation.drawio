<mxfile host="CT-CORA3D"><diagram id="d" name="validation"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Niveau 1 — Cas simulés (fait)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;On déforme un os sain d'un angle connu, puis on vérifie que le programme retrouve cet angle.&lt;br&gt;Résultat : erreur inférieure à 0,01° ; 606 planifications et 742 guides sans erreur.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f5e4;strokeColor=#3a7d2c;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="700" height="100" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Niveau 2 — Robustesse (en partie)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;Os tourné au hasard, seuil de segmentation modifié, faux scanner de taille connue.&lt;br&gt;Reste à faire : d'autres scanners, d'autres races.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff6db;strokeColor=#b38600;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="10" y="130" width="700" height="100" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Niveau 3 — Vrais cas et essais imprimés (à faire)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;Scanners de chiens malades, comparaison avec le chirurgien,&lt;br&gt;impression des guides et essai sur un os imprimé.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fbe9e9;strokeColor=#b03a3a;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="10" y="250" width="700" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>