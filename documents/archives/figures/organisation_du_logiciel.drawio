<mxfile host="CT-CORA3D"><diagram id="d" name="organisation_du_logiciel"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Fenêtre de l'application (interface)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;onglet 1 « Segmentation CT » &amp;nbsp;·&amp;nbsp; onglet 2 « Planification CORA »&lt;br&gt;la planification est calculée dans la page (JavaScript)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdf0e2;strokeColor=#b8611a;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="480" height="96" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Programme de calcul (Python)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;lecture DICOM, segmentation, repères, construction des guides&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#1f5f8b;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="186" width="480" height="96" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Fichiers sur l'ordinateur&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;séries DICOM (lues) &amp;nbsp;·&amp;nbsp; dossier resultats/ (écrit)&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="352" width="480" height="76" as="geometry"/></mxCell><mxCell id="c5" value="demandes de calcul" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="résultats" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;Tout reste sur l'ordinateur&lt;/b&gt;&lt;br&gt;&lt;br&gt;Les deux parties se parlent par l'adresse locale 127.0.0.1.&lt;br&gt;&lt;br&gt;Aucune connexion Internet.&lt;br&gt;&lt;br&gt;Une seule application à double-cliquer (macOS)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="530" y="20" width="190" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>