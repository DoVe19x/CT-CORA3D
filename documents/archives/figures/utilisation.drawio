<mxfile host="CT-CORA3D"><diagram id="d" name="utilisation"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;1. Choisir la série&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;onglet 1 : liste des scanners&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#1f5f8b;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="210" height="80" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;2. Segmenter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;bouton « Segmenter » (1 à 2 min)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#1f5f8b;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="265" y="20" width="210" height="80" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;3. Vérifier les os&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;en coupes et en 3D&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#1f5f8b;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="510" y="20" width="210" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;4. Planifier&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;onglet 2 : 13 étapes expliquées&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdf0e2;strokeColor=#b8611a;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="510" y="160" width="210" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;5. Construire les guides&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;étape 12 (environ 20 s)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f5e4;strokeColor=#3a7d2c;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="265" y="160" width="210" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;6. Récupérer les fichiers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;STL à imprimer, plans 2D&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f5e4;strokeColor=#3a7d2c;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="210" height="80" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;