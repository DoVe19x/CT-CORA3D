          <mxGeometry height="70" width="460" x="2093" y="1770" as="geometry" />
        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-51" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
