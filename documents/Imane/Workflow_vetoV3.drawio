            <mxPoint x="-1270" y="6070" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-106" parent="1" style="whiteSpace=wrap;html=1;fontSize=16;" value="&lt;b&gt;Si T &amp;gt; T_max → règle 2&lt;/b&gt; : l&#39;ACA virtuelle au niveau du CORA (d2=0)&lt;div&gt;→ rotation de ω à la charnière, &lt;strong&gt;puis&lt;/strong&gt; translation de t le long du plan de coupe. Cette translation réaligne l’axe distal sur l’axe proximal.&lt;/div&gt;" vertex="1">
          <mxGeometry height="99" width="549.5" x="-100" y="7380" as="geometry" />
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-107" edge="1" parent="1" source="GvjPP35lBfGDGBxoovV8-108" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;endArrow=none;endFill=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="745" y="8540" />
              <mxPoint x="220" y="8540" />
            </Array>
            <mxPoint x="190" y="8540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-108" parent="1" style="whiteSpace=wrap;html=1;fontSize=16;" value="&lt;strong&gt;Si T ≤ T_max → règle 3&lt;/strong&gt; : l&#39;ACA = charnière H (d2=d1)&lt;div&gt;→ rotation seule. Les axes restent parallèles mais décalés, et ce décalage est jugé acceptable.&lt;/div&gt;" vertex="1">
          <mxGeometry height="99.5" width="510.5" x="519.5" y="7380" as="geometry" />
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-109" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="890" width="893.22" x="37.90000000000009" y="6368.5" as="geometry" />
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-110" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="A : pas de translation nécessaire&lt;div&gt;B : translation obligatoire car t non nul, décalage présent&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="410" x="1580" y="6580" as="geometry" />
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-111" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="341" width="324.51" x="919.5" y="6558" as="geometry" />
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-112" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="remarque : mon T représente le t dans le schéma publiée dans l&#39;article ! C&#39;est la même chose." vertex="1">
          <mxGeometry height="50" width="680" x="859.5" y="7159.5" as="geometry" />
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-113" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="926" width="1093" x="-643.5" y="7519.5" as="geometry" />
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-114" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="926" width="1093" x="520" y="7519.5" as="geometry" />
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-115" parent="1" style="shape=requiredInterface;html=1;verticalLabelPosition=bottom;sketch=0;" value="" vertex="1">
          <mxGeometry height="45" width="30" x="-1270" y="6022.5" as="geometry" />
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-116" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=21;fillColor=#ffcccc;strokeColor=#36393d;align=center;verticalAlign=middle;" value="Hypothèse : la formule T = 2·d₁·tan(ω/2) a été validée pour des ostéotomies d’ouverture (Barksfield &amp;amp; Monsell 2015, humain, plan frontal, par simulation). Nous l’étendons à la fermeture et à l’ostéotomie neutre, car T ne dépend que de d₁ et de ω. Le type d’ostéotomie change seulement la position de la charnière en travers de l’os (d₃), donc la longueur, et non l’écart entre les axes. Cette branche ne concerne que la partie angulaire (angulation seule, ou angulation + torsion) ; la torsion est corrigée séparément par une rotation autour de l’axe long." vertex="1">
          <mxGeometry height="200" width="960" x="4.5" y="5767.5" as="geometry" />
        </mxCell>
        <UserObject label="https://link.springer.com/article/10.1007/s11751-015-0232-4" link="https://link.springer.com/article/10.1007/s11751-015-0232-4" id="GvjPP35lBfGDGBxoovV8-117">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="40" width="350" x="1781.5299999999997" y="6700" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="GvjPP35lBfGDGBxoovV8-118" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="Pour l&#39;instant, on ne propose pas vraiment la meilleur position possible pour faire la meilleur coupe et donc la meilleur correction vu qu&#39;on lui demande d&#39;imposer le d1.&lt;div&gt;Je ne sais pas trop, je suis mitigée. Il faudrait alors repartir de l&#39;article, voir ce qu&#39;ils ont fait pour l&#39;article : ils ont testé 9 os déformé et à partir de ça ils ont déterminé une manière de savoir où couper, le meilleur choix à faire. Faudrait creuser cela.&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="590" x="2364" y="7070" as="geometry" />
        </mxCell>
        <UserObject label="file:///C:/Users/aesso/Downloads/simulation_osteotomie_v4.html" link="file:///C:/Users/aesso/Downloads/simulation_osteotomie_v4.html" id="GvjPP35lBfGDGBxoovV8-119">
