        <UserObject label="https://www.researchgate.net/profile/Massimo-Petazzoni/publication/274082887_Atlas_of_Clinical_Goniometry_and_Radiographic_Measurements_of_the_Canine_Pelvic_Limb/links/5d2eaf8c458515c11c36ca66/Atlas-of-Clinical-Goniometry-and-Radiographic-Measurements-of-the-Canine-Pelvic-Limb.pdf" link="https://www.researchgate.net/profile/Massimo-Petazzoni/publication/274082887_Atlas_of_Clinical_Goniometry_and_Radiographic_Measurements_of_the_Canine_Pelvic_Limb/links/5d2eaf8c458515c11c36ca66/Atlas-of-Clinical-Goniometry-and-Radiographic-Measurements-of-the-Canine-Pelvic-Limb.pdf" id="9InLeOVrwz_Piia6F0kD-173">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;" vertex="1">
            <mxGeometry height="70" width="1180" x="-2236.58" y="700" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="9InLeOVrwz_Piia6F0kD-174" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontStyle=0;fontSize=12;" value="&lt;font&gt;https://pmc.ncbi.nlm.nih.gov/articles/PMC8234394/pdf/animals-11-01804.pdf&lt;/font&gt;&lt;div&gt;&lt;font&gt;https://pmc.ncbi.nlm.nih.gov/articles/PMC10373893/pdf/fvets-10-1194167.pdf&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="816.66" x="-2064.91" y="1210" as="geometry" />
        </mxCell>
        <mxCell id="9InLeOVrwz_Piia6F0kD-175" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-1657.2900000000002" y="1250" as="sourcePoint" />
            <mxPoint x="-1656.9566666666667" y="1327" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9InLeOVrwz_Piia6F0kD-176" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontStyle=0;fontSize=20;" value="&lt;font&gt;On construit notre table de référence par race à partir de Petazzoni 2008 pour le plan frontal, Aghapour 2021 pour le plan sagittal et la torsion fémorale, Brühschwein 2023 pour la torsion tibiale. Elle nous servira comme base de donnée pour faire la comparaison avec les angles mesurés.&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="894.99" x="-2104.07" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="9InLeOVrwz_Piia6F0kD-178" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="530" width="1127.01" x="-2570" y="1440" as="geometry" />
        </mxCell>
        <mxCell id="9InLeOVrwz_Piia6F0kD-185" parent="1" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="74" width="74" x="-470" y="1065" as="geometry" />
        </mxCell>
        <mxCell id="9InLeOVrwz_Piia6F0kD-189" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=20;" value="&lt;div&gt;Pour l’algorithme :&lt;/div&gt;&lt;ol dir=&quot;ltr&quot;&gt;&lt;li&gt;Race exacte et valeur présente → on utilise la valeur.&lt;/li&gt;&lt;li&gt;Race absente ou valeur absente → alerte : « il n’y a pas de référence fiable ».&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="115" width="894.99" x="-2550" y="2175" as="geometry" />
        </mxCell>
        <mxCell id="9InLeOVrwz_Piia6F0kD-190" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=0;fontSize=20;" value="&lt;ol dir=&quot;ltr&quot;&gt;&lt;li&gt;Les grandes races (Golden, Labrador, Berger allemand, Rottweiler) n’ont que le fémur frontal.&lt;/li&gt;&lt;li&gt;Les petites races n’ont que le plan sagittal et la torsion.&lt;/li&gt;&lt;li&gt;Le Chihuahua est la race la mieux couverte (4 catégories sur 6), mais il n’a rien en plan frontal.&lt;/li&gt;&lt;li&gt;Le tibia frontal (mMPTA 93°, mMDTA 96°) n’existe qu’en valeur générale, toutes races confondues.&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="150" width="894.99" x="-2550" y="1990" as="geometry" />
        </mxCell>
        <mxCell id="9InLeOVrwz_Piia6F0kD-194" edge="1" parent="1" source="9InLeOVrwz_Piia6F0kD-190" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="9InLeOVrwz_Piia6F0kD-190">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9InLeOVrwz_Piia6F0kD-195" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-2104.07" y="2110" as="sourcePoint" />
            <mxPoint x="-2103.646666666667" y="2187" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9InLeOVrwz_Piia6F0kD-197" connectable="0" parent="9InLeOVrwz_Piia6F0kD-195" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=20;" value="DONC" vertex="1">
          <mxGeometry relative="1" x="-0.2968" y="-4" as="geometry">
            <mxPoint x="4" y="8" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9InLeOVrwz_Piia6F0kD-198" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=0;fontSize=20;fontColor=#FF0000;" value="Remarque : la mesure de notre algorithme et la table doivent utiliser le même sens (négatif = torsion externe). Sinon, une torsion normale pourrait être lue comme une déformation !!" vertex="1">
          <mxGeometry height="70" width="894.99" x="-1655.01" y="2197.5" as="geometry" />
        </mxCell>
        <mxCell id="9InLeOVrwz_Piia6F0kD-199" edge="1" parent="1" source="9InLeOVrwz_Piia6F0kD-100" style="edgeStyle=orthogonalEdgeStyle;shape=flexArrow;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.002;entryY=0.274;entryDx=0;entryDy=0;entryPerimeter=0;" target="9InLeOVrwz_Piia6F0kD-180">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-215" y="1095" />
              <mxPoint x="-215" y="1093" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="9InLeOVrwz_Piia6F0kD-204" edge="1" parent="1" source="9InLeOVrwz_Piia6F0kD-200" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="9InLeOVrwz_Piia6F0kD-203" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9InLeOVrwz_Piia6F0kD-200" parent="1" style="whiteSpace=wrap;html=1;fontSize=16;rounded=0;strokeWidth=1.5;labelBackgroundColor=none;fontStyle=0;labelBorderColor=none;gradientColor=none;" value="&lt;b&gt;Règles de Paley&lt;/b&gt;&lt;div&gt;&lt;b&gt;Où se trouve l&#39;ACA et donc où réaliser l&#39;ostéotomie ?&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="421.75" x="325.13" y="1720" as="geometry" />
        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-8" edge="1" parent="1" source="9InLeOVrwz_Piia6F0kD-203" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="vWtjddDpPUx6_ixbL2a8-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9InLeOVrwz_Piia6F0kD-203" parent="1" style="whiteSpace=wrap;html=1;fontSize=16;rounded=0;strokeWidth=1.5;labelBackgroundColor=none;fontStyle=0;labelBorderColor=none;gradientColor=none;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;DONC&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Règle 1 par défaut : le plan de coupe et l&#39;ACA passent tous les deux par le CORA.&lt;/b&gt;" vertex="1">
