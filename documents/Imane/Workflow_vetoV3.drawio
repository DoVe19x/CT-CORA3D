        <mxCell id="Flod0ASNov0fCgBefIBF-1" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;rounded=0;fontSize=35;fontStyle=1;fillColor=#f9f7ed;strokeColor=#36393d;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;BUT du projet&lt;/span&gt;&lt;/div&gt;Automatiser la totalité du processus de la création d&#39;un guide de coupe et PAS de proposer le meilleur endroit où réaliser l&#39;ostéotomie et conceptionnaliser le guide de coupe" vertex="1">
          <mxGeometry height="240" width="1539" x="-233.5" y="-380" as="geometry" />
