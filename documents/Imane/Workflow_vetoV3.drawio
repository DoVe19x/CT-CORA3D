        <mxCell id="GvjPP35lBfGDGBxoovV8-98" parent="1" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;strokeWidth=1.5;rounded=0;labelBackgroundColor=none;fontStyle=0;labelBorderColor=none;textShadow=0;" value="&lt;b&gt;T = 2·tan(ω/2)·d_1 ≤ T_max ?&lt;/b&gt;&lt;div&gt;où T_max [mm] = T_max [%]*largeur de l&#39;os&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="430.63" x="269.19000000000005" y="6154.5" as="geometry" />
        </mxCell>
