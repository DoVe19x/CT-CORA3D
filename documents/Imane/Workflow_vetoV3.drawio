        <mxCell id="GvjPP35lBfGDGBxoovV8-103" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;fontStyle=5" value="Formule pubiée par Baskerfield &amp;amp; Monsell (2015) pour calculer l&#39;écart entre les deux axes, le lond du plan de coupe avant la rotation sur l&#39;os déformé" vertex="1">
          <mxGeometry height="30" width="772.97" x="1570.0400000000004" y="5719.5" as="geometry" />
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-104" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="Ils l&#39;ont validée par simulation numérique (TraumaCad) sur 9 modèles humains de fémur et de tibia avec une correlation de 0,93 à 0,99." vertex="1">
          <mxGeometry height="90" width="410" x="2380" y="6278.5" as="geometry" />
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-105" edge="1" parent="1" source="GvjPP35lBfGDGBxoovV8-106" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;endArrow=none;endFill=0;">
          <mxGeometry relative="1" as="geometry">
