        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;rounded=1;fontSize=14;gradientColor=none;shadow=0;" value="La seule chose de différente par la suite sera l&#39;emplacement de la charnière si on est en règle 2 ou 3. C&#39;est tout, la logique reste la même." vertex="1">
