        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-55" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;fontStyle=5" value="Formule pubiée par Baskerfield &amp;amp; Monsell (2015) pour calculer l&#39;écart entre les deux axes, le lond du plan de coupe avant la rotation sur l&#39;os déformé" vertex="1">
          <mxGeometry height="30" width="772.97" x="3990.0400000000004" y="1949.5" as="geometry" />
        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-56" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="Ils l&#39;ont validée par simulation numérique (TraumaCad) sur 9 modèles humains de fémur et de tibia avec une correlation de 0,93 à 0,99." vertex="1">
          <mxGeometry height="90" width="410" x="4800" y="2508.5" as="geometry" />
        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-94" edge="1" parent="1" source="vWtjddDpPUx6_ixbL2a8-58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;endArrow=none;endFill=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2644" y="4770" />
              <mxPoint x="1150" y="4770" />
