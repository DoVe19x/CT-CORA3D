        <mxCell id="vWtjddDpPUx6_ixbL2a8-18" parent="1" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;strokeWidth=1.5;rounded=0;labelBackgroundColor=none;fontStyle=0;labelBorderColor=none;textShadow=0;" value="&lt;b&gt;T = 2·tan(ω/2)·d_1 ≤ T_max ?&lt;/b&gt;&lt;div&gt;où T_max [mm] = T_max [%]*largeur de l&#39;os&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="430.63" x="2689.19" y="2384.5" as="geometry" />
        </mxCell>
