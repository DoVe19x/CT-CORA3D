        <UserObject label="https://www.researchgate.net/profile/Massimo-Petazzoni/publication/274082887_Atlas_of_Clinical_Goniometry_and_Radiographic_Measurements_of_the_Canine_Pelvic_Limb/links/5d2eaf8c458515c11c36ca66/Atlas-of-Clinical-Goniometry-and-Radiographic-Measurements-of-the-Canine-Pelvic-Limb.pdf" link="https://www.researchgate.net/profile/Massimo-Petazzoni/publication/274082887_Atlas_of_Clinical_Goniometry_and_Radiographic_Measurements_of_the_Canine_Pelvic_Limb/links/5d2eaf8c458515c11c36ca66/Atlas-of-Clinical-Goniometry-and-Radiographic-Measurements-of-the-Canine-Pelvic-Limb.pdf" id="GvjPP35lBfGDGBxoovV8-62">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;" vertex="1">
            <mxGeometry height="70" width="1180" x="-4656.58" y="4470" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="GvjPP35lBfGDGBxoovV8-63" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontStyle=0;fontSize=12;" value="&lt;font&gt;https://pmc.ncbi.nlm.nih.gov/articles/PMC8234394/pdf/animals-11-01804.pdf&lt;/font&gt;&lt;div&gt;&lt;font&gt;https://pmc.ncbi.nlm.nih.gov/articles/PMC10373893/pdf/fvets-10-1194167.pdf&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="816.66" x="-4484.91" y="4980" as="geometry" />
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-64" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4077.29" y="5020" as="sourcePoint" />
            <mxPoint x="-4076.956666666667" y="5097" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-65" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontStyle=0;fontSize=20;" value="&lt;font&gt;On construit notre table de référence par race à partir de Petazzoni 2008 pour le plan frontal, Aghapour 2021 pour le plan sagittal et la torsion fémorale, Brühschwein 2023 pour la torsion tibiale. Elle nous servira comme base de donnée pour faire la comparaison avec les angles mesurés.&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="894.99" x="-4524.07" y="5130" as="geometry" />
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-66" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="530" width="1127.01" x="-4990" y="5210" as="geometry" />
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-67" parent="1" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="74" width="74" x="-2890" y="4835" as="geometry" />
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-68" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=20;" value="&lt;div&gt;Pour l’algorithme :&lt;/div&gt;&lt;ol dir=&quot;ltr&quot;&gt;&lt;li&gt;Race exacte et valeur présente → on utilise la valeur.&lt;/li&gt;&lt;li&gt;Race absente ou valeur absente → alerte : « il n’y a pas de référence fiable ».&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="115" width="894.99" x="-4970" y="5945" as="geometry" />
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-69" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=0;fontSize=20;" value="&lt;ol dir=&quot;ltr&quot;&gt;&lt;li&gt;Les grandes races (Golden, Labrador, Berger allemand, Rottweiler) n’ont que le fémur frontal.&lt;/li&gt;&lt;li&gt;Les petites races n’ont que le plan sagittal et la torsion.&lt;/li&gt;&lt;li&gt;Le Chihuahua est la race la mieux couverte (4 catégories sur 6), mais il n’a rien en plan frontal.&lt;/li&gt;&lt;li&gt;Le tibia frontal (mMPTA 93°, mMDTA 96°) n’existe qu’en valeur générale, toutes races confondues.&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="150" width="894.99" x="-4970" y="5760" as="geometry" />
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-70" edge="1" parent="1" source="GvjPP35lBfGDGBxoovV8-69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="GvjPP35lBfGDGBxoovV8-69">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-71" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4524.07" y="5880" as="sourcePoint" />
            <mxPoint x="-4523.646666666667" y="5957" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-72" connectable="0" parent="GvjPP35lBfGDGBxoovV8-71" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=20;" value="DONC" vertex="1">
          <mxGeometry relative="1" x="-0.2968" y="-4" as="geometry">
            <mxPoint x="4" y="8" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="GvjPP35lBfGDGBxoovV8-73" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=0;fontSize=20;fontColor=#FF0000;" value="Remarque : la mesure de notre algorithme et la table doivent utiliser le même sens (négatif = torsion externe). Sinon, une torsion normale pourrait être lue comme une déformation !!" vertex="1">
          <mxGeometry height="70" width="894.99" x="-4075.01" y="5967.5" as="geometry" />
        </mxCell>
