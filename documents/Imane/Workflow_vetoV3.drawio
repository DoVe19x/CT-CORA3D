            <mxPoint x="1150" y="2300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-58" parent="1" style="whiteSpace=wrap;html=1;fontSize=16;" value="&lt;b&gt;Si T &amp;gt; T_max → règle 2&lt;/b&gt; : l&#39;ACA virtuelle au niveau du CORA (d2=0)&lt;div&gt;→ rotation de ω à la charnière, &lt;strong&gt;puis&lt;/strong&gt; translation de t le long du plan de coupe. Cette translation réaligne l’axe distal sur l’axe proximal.&lt;/div&gt;" vertex="1">
          <mxGeometry height="99" width="549.5" x="2320" y="3610" as="geometry" />
        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-95" edge="1" parent="1" source="vWtjddDpPUx6_ixbL2a8-59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;endArrow=none;endFill=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="3165" y="4770" />
              <mxPoint x="2640" y="4770" />
            </Array>
            <mxPoint x="2610" y="4770" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-59" parent="1" style="whiteSpace=wrap;html=1;fontSize=16;" value="&lt;strong&gt;Si T ≤ T_max → règle 3&lt;/strong&gt; : l&#39;ACA = charnière H (d2=d1)&lt;div&gt;→ rotation seule. Les axes restent parallèles mais décalés, et ce décalage est jugé acceptable.&lt;/div&gt;" vertex="1">
          <mxGeometry height="99.5" width="510.5" x="2939.5" y="3610" as="geometry" />
        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-68" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="890" width="893.22" x="2457.9" y="2598.5" as="geometry" />
        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-70" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="A : pas de translation nécessaire&lt;div&gt;B : translation obligatoire car t non nul, décalage présent&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="410" x="4000" y="2810" as="geometry" />
        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-71" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="341" width="324.51" x="3339.5" y="2788" as="geometry" />
        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-72" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="remarque : mon T représente le t dans le schéma publiée dans l&#39;article ! C&#39;est la même chose." vertex="1">
          <mxGeometry height="50" width="680" x="3279.5" y="3389.5" as="geometry" />
        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-74" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="926" width="1093" x="1776.5" y="3749.5" as="geometry" />
        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-75" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="926" width="1093" x="2940" y="3749.5" as="geometry" />
        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-86" parent="1" style="shape=requiredInterface;html=1;verticalLabelPosition=bottom;sketch=0;" value="" vertex="1">
          <mxGeometry height="45" width="30" x="1150" y="2252.5" as="geometry" />
        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-96" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=21;fillColor=#ffcccc;strokeColor=#36393d;align=center;verticalAlign=middle;" value="Hypothèse : la formule T = 2·d₁·tan(ω/2) a été validée pour des ostéotomies d’ouverture (Barksfield &amp;amp; Monsell 2015, humain, plan frontal, par simulation). Nous l’étendons à la fermeture et à l’ostéotomie neutre, car T ne dépend que de d₁ et de ω. Le type d’ostéotomie change seulement la position de la charnière en travers de l’os (d₃), donc la longueur, et non l’écart entre les axes. Cette branche ne concerne que la partie angulaire (angulation seule, ou angulation + torsion) ; la torsion est corrigée séparément par une rotation autour de l’axe long." vertex="1">
          <mxGeometry height="200" width="960" x="2424.5" y="1997.5" as="geometry" />
        </mxCell>
        <UserObject label="https://link.springer.com/article/10.1007/s11751-015-0232-4" link="https://link.springer.com/article/10.1007/s11751-015-0232-4" id="vWtjddDpPUx6_ixbL2a8-98">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;" vertex="1">
