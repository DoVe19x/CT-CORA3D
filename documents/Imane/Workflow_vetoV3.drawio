        <mxCell id="T5alzieGd8T_t7U3U9PQ-165" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;strokeWidth=1.5;labelBackgroundColor=none;fontStyle=0;labelBorderColor=none;textShadow=0;" value="&lt;b&gt;RÈGLE 3&lt;/b&gt; (T ≤ T_max)&lt;br&gt;ACA et coupe au même niveau, hors du CORA&lt;br&gt;→ rotation seule : axes parallèles décalés de&lt;br&gt;δ = 2·d₂·sin(ω/2) ≈ T·cos(ω/2) (calcul du projet)&lt;br&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;INFORMATION&lt;/b&gt; : décalage accepté&lt;/div&gt;" vertex="1">
