          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="T5alzieGd8T_t7U3U9PQ-174" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;strokeWidth=1.5;labelBackgroundColor=none;fontStyle=0;labelBorderColor=none;textShadow=0;" value="&lt;b&gt;Localisation de l&#39;axe ACA + calcul pour la nouvelle coupe&lt;/b&gt;&lt;div&gt;- plan de coupe situé grâce à → normale e et point CORA + d₁ le long de e&lt;/div&gt;&lt;div&gt;- axe ACA repositionné&lt;br&gt;&lt;div&gt;- &lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;charnière sur la coupe donc d₂ = d₁ toujours !&lt;/font&gt;&lt;/div&gt;&lt;div&gt;puis T = 2·d₁·tan(ω/2)&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="380" x="1560" y="2980" as="geometry" />
        </mxCell>
        <mxCell id="T5alzieGd8T_t7U3U9PQ-175" edge="1" parent="1" source="T5alzieGd8T_t7U3U9PQ-174" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=default;fontSize=16;fontStyle=0;labelBorderColor=none;textShadow=0;labelBackgroundColor=default;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="T5alzieGd8T_t7U3U9PQ-171" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="T5alzieGd8T_t7U3U9PQ-176" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;rounded=1;fontSize=14;gradientColor=none;shadow=0;" value="- d1 est la distance entre le CORA et le plan de coupe&lt;div&gt;- d2 est la distance entre la bissectrice et l&#39;axe ACA&lt;br&gt;&lt;div&gt;- T_max est la tolérance maximal définit par le chirurgien&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="390" x="1830" y="3300" as="geometry" />
        </mxCell>
        <mxCell id="T5alzieGd8T_t7U3U9PQ-177" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#36393d;fillColor=#cce5ff;align=center;verticalAlign=middle;rounded=1;fontSize=14;" value="On redresse le segment distal et il devient // à l&#39;axe proximale.&lt;div&gt;L&#39;écart entre les axes // est donc la somme des 2 distances (voir schéma que je ferai au propre pour mieux visualiser et comprendre d&#39;où sortent les formules) :&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;δ&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;=&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;d₂·sin(&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;α)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;+ d₂·sin(α) = 2·d₂·sin α = 2·d₂·sin(ω/2)&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="510" x="2020" y="2790" as="geometry" />
        </mxCell>
        <mxCell id="T5alzieGd8T_t7U3U9PQ-178" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;rounded=1;fontSize=14;" value="On sait où est à nouveau le plan de coupe. Cela implique de redéfinir la position de l&#39;axe ACA ; il faut savoir si il est sur le point CORA ou au niveau du plan de coupe pour savoir si on suit la règle 2 et 3. Mais donc l&#39;idée est de calculer&amp;nbsp;&lt;span&gt;T = 2·tan(ω/2)·d₁. Au moment où le chirurgien impose d1, on lui demande aussi d&#39;imposer une certaine tolérance acceptable T_max. Et en fonction de si le T calculé est supérieur ou inférieur à T_max alors on s&#39;est se situer, savoir quel règle suivre et puis, on lance la simulation et ainsi de suite.&lt;/span&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;→&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;δ et T ne dépendent que de la position de l’ACA le long de e (d₂ = d₁) ! &lt;/span&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Et d&#39;ailleurs, l&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;e côté de la charnière (convexe ou concave) n’y change rien ainsi que sa position, elle sera toujours sur la coupe !!&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;Il faut juste comprendre que :&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;règle 2 : rotation puis glissement de T → résultat : axes alignés,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;δ&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp;=0&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;règle&amp;nbsp; : rotation seule autour la charnière → résultat : axes //, décalés de&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;δ&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp;(accepté)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="690" x="2060" y="2970" as="geometry" />
        </mxCell>
        <mxCell id="T5alzieGd8T_t7U3U9PQ-180" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;rounded=1;fontSize=14;gradientColor=none;shadow=0;" value="PAS de CORA pour la torsion, elle en a pas donc la règle de Paley dne s&#39;applique pas." vertex="1">
          <mxGeometry height="60" width="540" x="993.5" y="2220" as="geometry" />
        </mxCell>
        <mxCell id="T5alzieGd8T_t7U3U9PQ-181" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#9673a6;fillColor=#e1d5e7;align=center;verticalAlign=middle;rounded=1;fontSize=15;fontColor=#B266FF;" value="https://pmc.ncbi.nlm.nih.gov/articles/PMC4666231/#Fig7?ct=1792394787175" vertex="1">
          <mxGeometry height="35" width="540" x="1570" y="2365" as="geometry" />
        </mxCell>
        <mxCell id="T5alzieGd8T_t7U3U9PQ-182" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;ATTENTION ma logique peut être totaleme,t fausse car faut d&#39;abord bien comprendre comment on définit l&#39;axe ACA vu qu&#39;à la règle 2 elle est au CORA et à la règle 3 elle est au niveau du plan de coupe donc là j&#39;avoue que je susi perdue. Parce que je dis de calculer le T et savoir si c&#39;est la règle 2 ou 3 mais du coup si j&#39;ai déjà mon ACA ça me bloque parce que ça me dit déjà laquelle suivre et donc je ne vois plus l&#39;utilité de la formule fin si elle va permettre de du coup&amp;nbsp; juste avoir la sortie des paramètres qui vont servir pour la conception du guide spécifique au patient.&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="450" x="2570" y="3680" as="geometry" />
        </mxCell>
