        <mxCell id="vWtjddDpPUx6_ixbL2a8-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;rounded=1;fontSize=14;gradientColor=none;shadow=0;" value="C&#39;est de cette manière que l&#39;on sait où est positionné l&#39;ACA. C&#39;est pas à nous de la trouver ou la calculer." vertex="1">
          <mxGeometry height="70" width="540" x="-340" y="1820" as="geometry" />
        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-20" edge="1" parent="1" source="vWtjddDpPUx6_ixbL2a8-16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="vWtjddDpPUx6_ixbL2a8-18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=16;strokeWidth=1.5;labelBackgroundColor=none;fontStyle=0;labelBorderColor=none;textShadow=0;spacingLeft=31;fillColor=#ffff88;strokeColor=#36393d;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Il entre alors&lt;/span&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt; 2 paramètres&lt;/b&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; :&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;- &lt;b style=&quot;&quot;&gt;d_1&lt;/b&gt; = distance entre le CORA et le plan de coupe le long de la bissectrice c, c&#39;est-à-dire où est-ce qu&#39;on coupe par rapport au CORA ?&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- &lt;b&gt;T_max&lt;/b&gt; = tolérance maximale en % de la largeur de l&#39;os (pour que ce soit adapté à tout type de race), elle permet de savoir si en plus de la rotation, il faut appliquer une translation supplémentaire ou non.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="810" x="2499.5" y="2214.5" as="geometry" />
        </mxCell>
        <mxCell id="vWtjddDpPUx6_ixbL2a8-52" edge="1" parent="1" source="vWtjddDpPUx6_ixbL2a8-18" style="edgeStyle=none;shape=flexArrow;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="vWtjddDpPUx6_ixbL2a8-51">
