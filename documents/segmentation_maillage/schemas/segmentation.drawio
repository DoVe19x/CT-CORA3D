<mxfile host="CT-CORA3D"><diagram id="d" name="segmentation"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Volume en HU&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;zone recadrée autour des os denses (≥ 500 HU, marge 6 mm)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#5b6b7a;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="300" height="74" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Lissage gaussien&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;σ = 0,35 mm : le bruit est divisé par deux&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#1f5f8b;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="200" y="130" width="300" height="74" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Masque osseux&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;seuil BAS : I ≥ 226 HU&lt;br&gt;l'os entier, mais les os se touchent&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#1f5f8b;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="300" height="92" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Graines&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;seuil HAUT qui monte de 500 à 1500 HU&lt;br&gt;un noyau dense par os (arbre des seuils)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#1f5f8b;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="380" y="250" width="300" height="92" as="geometry"/></mxCell><mxCell id="c6" value=