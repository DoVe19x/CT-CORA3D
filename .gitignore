# Fichiers système macOS / Windows
.DS_Store
Thumbs.db

# Caches Python
__pycache__/
*.pyc

# Historique R vide
.Rhistory

# Fichiers temporaires Office
~$*

# Fichiers intermédiaires de LaTeX (dossier complet)
documents/dossier_complet/construction/

# Images DICOM : jamais sur GitHub. Le dossier dicom/ est trop lourd (≈ 17 Go) : chacun garde ses séries sur son
# ordinateur. Les en-têtes des scanners de Zurich portent aussi le nom du propriétaire de l'animal.
dicom/
*.dcm
DICOMDIR
*.zip

# Résultats : tout ce que produit l'application reste sur l'ordinateur. Les exemples partagés (séries du lévrier,
# guides de l'os fictif) sont dans exemples/ ; l'application les copie dans resultats/ au démarrage.
resultats/
